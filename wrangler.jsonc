{
  "name": "lefabriquecr",
  "main": "worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "PROMOS_KV",
      "id": "a0bc71afa8fe4bfeb8c2da4e0f82011e"
    }
  ],
  "routes": [
    {
      "pattern": "uniformeslefabrique.com/*",
      "zone_name": "uniformeslefabrique.com"
    },
    {
      "pattern": "www.uniformeslefabrique.com/*",
      "zone_name": "uniformeslefabrique.com"
    }
  ]
}
