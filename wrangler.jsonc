{
  "name": "lefabriquecr",
  "main": "worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "uniformeslefabrique.com/*",
      "zone_name": "uniformeslefabrique.com"
    },
    {
      "pattern": "www.uniformeslefabrique.com/*",
      "zone_name": "uniformeslefabrique.com"
    }
  ]
}
